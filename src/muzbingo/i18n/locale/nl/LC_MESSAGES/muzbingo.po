msgid "(removed song)"
msgstr "(verwijderd nummer)"

#, python-brace-format
msgid "A {rows}×{cols} card needs {needed} songs, but the playlist has only {n}"
msgstr "Een kaart van {rows}×{cols} heeft {needed} nummers nodig, maar de playlist heeft er maar {n}"

#, python-brace-format
msgid "A {rows}×{cols} card needs {needed} songs; the playlist has {n}. Add songs or use a smaller grid."
msgstr ""
"Een kaart van {rows}×{cols} heeft {needed} nummers nodig; de playlist heeft er {n}. Voeg nummers "
"toe of kies een kleiner raster."

msgid "Add"
msgstr "Toevoegen"

msgid "Add a song"
msgstr "Nummer toevoegen"

#, python-brace-format
msgid "Add a {ext} file, for example one you downloaded on another computer."
msgstr "Voeg een {ext}-bestand toe, bijvoorbeeld een dat je op een andere computer hebt gedownload."

msgid "Add song"
msgstr "Nummer toevoegen"

msgid "Add to the current playlist instead of replacing it"
msgstr "Toevoegen aan de huidige playlist in plaats van die te vervangen"

msgid "After the import you will need to generate new cards."
msgstr "Na het importeren moet je nieuwe kaarten maken."

msgid "All cards change. Cards you already printed will no longer match this game."
msgstr "Alle kaarten veranderen. Kaarten die je al hebt afgedrukt, passen dan niet meer bij dit spel."

msgid "All songs are marked as not played. You can undo this."
msgstr "Alle nummers worden als niet gespeeld gemarkeerd. Je kunt dit ongedaan maken."

msgid "All texts fit on the cards. Switch off \"Only songs that are too long\" to see all songs."
msgstr ""
"Alle teksten passen op de kaarten. Zet \"Alleen nummers die te lang zijn\" uit om alle nummers te"
" zien."

